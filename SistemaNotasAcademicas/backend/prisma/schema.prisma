generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model estudiantes {
  id      Int     @id @default(autoincrement())
  nombre  String
  ci      String?
  email   String?
  notas   notas[]
}

model materias {
  id     Int    @id @default(autoincrement())
  nombre String
  notas  notas[]
}

model notas {
  id           Int       @id @default(autoincrement())
  estudiante_id Int
  materia_id   Int
  nota         Float

  estudiantes  estudiantes @relation(fields: [estudiante_id], references: [id])
  materias     materias    @relation(fields: [materia_id], references: [id])
}
